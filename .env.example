# ============================================
# SIP-UM Docker Compose Environment Variables
# Copy file ini: cp .env.example .env
# Lalu isi dengan nilai yang sebenarnya
# ============================================

# Database
DB_ROOT_PASSWORD=rootpassword_ganti_ini
DB_PASSWORD=sippassword_ganti_ini

# JWT (gunakan random string panjang)
JWT_TOKEN_SECRET=your-super-secret-jwt-key-min-32-chars-change-this

# Google OAuth (dari Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# NextAuth (gunakan: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-change-this
